<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView is a direct child — no NestedScrollView wrapper. WebView owns
         its own scrolling/zooming internally; wrapping it in another
         scrollable container caused the touch dispatch to get split between
         the two, which is what made panning-while-zoomed feel frozen. -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:max="100"
        android:indeterminate="false"
        android:progressTint="#E50914"
        android:visibility="gone"/>

</RelativeLayout>